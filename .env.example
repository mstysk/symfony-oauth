# Copy this file to .env (gitignored) and fill in real values for local dev.
#
# DO NOT COMMIT secrets. This template ships with placeholders only.
# Generate the OAUTH_ENCRYPTION_KEY with:
#   docker compose run --rm app vendor/bin/generate-defuse-key

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Host fallback only — at runtime DATABASE_URL flows through compose.yaml
# (see CLAUDE.md). PoC uses SQLite, no server_version needed.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/oauth.db"
###< doctrine/doctrine-bundle ###

###> oauth ###
# Generate via: docker compose run --rm app vendor/bin/generate-defuse-key
OAUTH_ENCRYPTION_KEY=
###< oauth ###
